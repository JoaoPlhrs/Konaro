#!/usr/bin/make -f
# Konaro OS — efeito Liquid Glass (fonte em upstream/, patch em KONARO-PATCH.diff)
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

KWIN_VER := $(shell dpkg-query -W -f '$${Version}' libkwin6)

%:
	dh $@ --sourcedirectory=upstream --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DBETTERBLUR_X11=OFF

override_dh_gencontrol:
	dh_gencontrol -- -Vkwin:Depends="libkwin6 (= $(KWIN_VER))"

override_dh_strip:
	dh_strip --no-automatic-dbgsym
