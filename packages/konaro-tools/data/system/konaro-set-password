#!/bin/sh
# Konaro OS — troca a senha de quem chamou (só da própria conta).
# Roda via pkexec: a autorização (polkit) já confere a senha atual do usuário.
# A nova senha chega pela entrada padrão (nunca pela linha de comando).
set -eu
if [ "$(id -u)" -ne 0 ]; then exec pkexec /usr/lib/konaro/konaro-set-password; fi
uid="${PKEXEC_UID:-}"
[ -n "$uid" ] && [ "$uid" -ge 1000 ] || { echo "conta inválida" >&2; exit 1; }
user="$(getent passwd "$uid" | cut -d: -f1)"
[ -n "$user" ] || exit 1
IFS= read -r pass
[ -n "$pass" ] || { echo "senha vazia" >&2; exit 1; }
case "$pass" in *:*|*"
"*) echo "caractere inválido" >&2; exit 1 ;; esac
printf '%s:%s\n' "$user" "$pass" | chpasswd
