// Konaro OS — as Atualizações do Konaro podem criar o ponto de restauração
// "Antes da atualização" sem pedir senha de novo (só esse serviço, só para
// administradores na sessão local ativa).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "konaro-snapshot-update.service" &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
