#!/usr/bin/python3
"""Konaro OS — gera as imagens da página "Navegadores" do instalador.

Cada cartão mostra o ícone do navegador com a mesma "luz" usada na Loja Konaro
(o ícone ampliado e desfocado atrás) e o nome. Executado no build da imagem,
a partir dos ícones dos navegadores realmente instalados.
"""

import os
import sys

os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")

from PyQt6.QtCore import QRectF, Qt  # noqa: E402
from PyQt6.QtGui import QColor, QFont, QGuiApplication, QImage, QPainter  # noqa: E402

from konaro.qmlapp import make_glow  # noqa: E402

OUT = "/usr/share/konaro/installer"
FLATPAK_ICONS = "/var/lib/flatpak/exports/share/icons/hicolor"
CARDS = [
    ("firefox", "Firefox", ["/usr/share/konaro/store/icons/firefox-esr.png",
                            "/usr/share/icons/hicolor/128x128/apps/firefox-esr.png"]),
    ("brave", "Brave", ["/usr/share/icons/hicolor/256x256/apps/brave-browser.png",
                        "/usr/share/icons/hicolor/128x128/apps/brave-browser.png"]),
    ("ungoogled", "Ungoogled Chromium", [
        "/usr/share/konaro/store/icons/io.github.ungoogled_software.ungoogled_chromium.png",
        FLATPAK_ICONS + "/256x256/apps/io.github.ungoogled_software.ungoogled_chromium.png",
        FLATPAK_ICONS + "/128x128/apps/io.github.ungoogled_software.ungoogled_chromium.png"]),
]


def card(icon_path, name):
    smooth = Qt.TransformationMode.SmoothTransformation
    keep = Qt.AspectRatioMode.KeepAspectRatio
    icon = QImage(icon_path)
    image = QImage(640, 360, QImage.Format.Format_ARGB32_Premultiplied)
    image.fill(QColor(0, 0, 0, 0))
    painter = QPainter(image)
    painter.setRenderHint(QPainter.RenderHint.Antialiasing)
    painter.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
    glow = make_glow(icon.scaled(40, 40, keep, smooth)).scaled(420, 420, keep, smooth)
    painter.setOpacity(0.55)
    painter.drawImage(320 - 210, 150 - 210, glow)
    painter.setOpacity(1.0)
    painter.drawImage(QRectF(320 - 72, 150 - 72, 144, 144), icon.scaled(288, 288, keep, smooth))
    font = QFont("Inter Display", 26)
    font.setWeight(QFont.Weight.Bold)
    painter.setFont(font)
    painter.setPen(QColor("#1D1D1F"))
    painter.drawText(QRectF(0, 262, 640, 50), Qt.AlignmentFlag.AlignHCenter, name)
    painter.end()
    return image


def main():
    app = QGuiApplication(sys.argv)  # noqa: F841 — precisa existir durante a renderização
    os.makedirs(OUT, exist_ok=True)
    status = 0
    for key, name, candidates in CARDS:
        path = next((c for c in candidates if os.path.exists(c)), None)
        if path is None:
            print("make-browser-cards: AVISO: ícone não encontrado para", name, file=sys.stderr)
            status = 1
            continue
        card(path, name).save(os.path.join(OUT, "browser-%s.png" % key))
        print("make-browser-cards:", key, "<-", path)
    return status


if __name__ == "__main__":
    sys.exit(main())
