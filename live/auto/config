#!/bin/sh
# Konaro OS — configuração do Debian Live Build.
# Chamado por `lb config`. Não edite os arquivos gerados em config/ (binary,
# bootstrap, chroot, common, source): eles são recriados a partir daqui.
#
# Variáveis de ambiente opcionais:
#   KONARO_MIRROR           mirror Debian usado DURANTE o build
#   KONARO_SECURITY_MIRROR  mirror de segurança usado DURANTE o build
#   KONARO_APT_PROXY        proxy HTTP para o APT durante o build (ex.: apt-cacher-ng)
# O sistema gerado sempre aponta para os mirrors oficiais via HTTPS.
set -e

VERSION_FILE="$(dirname "$0")/../../VERSION"
KONARO_VERSION="$(cat "$VERSION_FILE" 2>/dev/null || echo dev)"
# Nome de arquivo sem caracteres problemáticos (~ vira -)
KONARO_VERSION_FS="$(echo "$KONARO_VERSION" | tr '~' '-')"
# Nome da versão (constelação, ex.: Fênix) e edição (vazio ou "lite"), gravados
# por scripts/build-iso.sh. No nome do arquivo: sem acento e em minúsculas.
KONARO_CODENAME="$(cat "$(dirname "$0")/../../CODENAME" 2>/dev/null || echo "")"
KONARO_EDITION="$(cat "$(dirname "$0")/../../EDITION" 2>/dev/null || echo "")"
KONARO_NAME_FS="$(printf '%s' "$KONARO_CODENAME" | sed 's/á/a/g; s/à/a/g; s/â/a/g; s/ã/a/g; s/é/e/g; s/ê/e/g; s/í/i/g; s/ó/o/g; s/ô/o/g; s/õ/o/g; s/ú/u/g; s/ü/u/g; s/ç/c/g; s/Á/a/g; s/Â/a/g; s/Ã/a/g; s/É/e/g; s/Ê/e/g; s/Í/i/g; s/Ó/o/g; s/Ô/o/g; s/Õ/o/g; s/Ú/u/g; s/Ç/c/g' | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')"
KONARO_IMAGE="konaro-os${KONARO_NAME_FS:+-$KONARO_NAME_FS}${KONARO_EDITION:+-$KONARO_EDITION}-${KONARO_VERSION_FS}"
KONARO_LABEL="$(printf 'KONARO_%s%s_%s' "$KONARO_NAME_FS" "${KONARO_EDITION:+_$KONARO_EDITION}" "$KONARO_VERSION_FS" | tr '[:lower:]' '[:upper:]' | cut -c1-32)"

# Arquitetura (gravada por scripts/build-iso.sh conforme a edição). Em 32 bits
# (i386) o Debian 13 não tem kernel nem instalador: o kernel vem do Debian 12
# (686-pae, com atualizações de segurança até 2028) e o boot é só BIOS.
KONARO_ARCH="$(cat "$(dirname "$0")/../../ARCH" 2>/dev/null || echo amd64)"
if [ "$KONARO_ARCH" = i386 ]; then
	KONARO_FLAVOURS="686-pae"; KONARO_BOOTLOADERS="grub-pc grub-efi"; KONARO_SECUREBOOT="disable"
	KONARO_ARCH_APPEND=" forcepae"
else
	KONARO_FLAVOURS="amd64"; KONARO_BOOTLOADERS="grub-pc grub-efi"; KONARO_SECUREBOOT="enable"
	KONARO_ARCH_APPEND=""
fi

KONARO_MIRROR="${KONARO_MIRROR:-http://deb.debian.org/debian}"
KONARO_SECURITY_MIRROR="${KONARO_SECURITY_MIRROR:-http://security.debian.org/debian-security}"

# PROVISÓRIO (ver docs/PENDING.md): idioma/teclado/fuso padrão da sessão live.
KONARO_LIVE_LOCALE="${KONARO_LIVE_LOCALE:-pt_BR.UTF-8}"
KONARO_LIVE_KEYBOARD="${KONARO_LIVE_KEYBOARD:-br}"
KONARO_LIVE_TIMEZONE="${KONARO_LIVE_TIMEZONE:-America/Sao_Paulo}"

set -- "$@"
if [ -n "${KONARO_APT_PROXY:-}" ]; then
	set -- "$@" --apt-http-proxy "${KONARO_APT_PROXY}"
fi

lb config noauto \
	--mode debian \
	--distribution trixie \
	--architectures "${KONARO_ARCH}" \
	--linux-flavours "${KONARO_FLAVOURS}" \
	--archive-areas "main non-free non-free-firmware" \
	--security true \
	--updates true \
	--apt-recommends true \
	--binary-image iso-hybrid \
	--bootloaders "${KONARO_BOOTLOADERS}" \
	--uefi-secure-boot "${KONARO_SECUREBOOT}" \
	--debian-installer none \
	--firmware-chroot true \
	--firmware-binary false \
	--cache true \
	--chroot-squashfs-compression-type zstd \
	--mirror-bootstrap "${KONARO_MIRROR}" \
	--mirror-chroot "${KONARO_MIRROR}" \
	--mirror-chroot-security "${KONARO_SECURITY_MIRROR}" \
	--mirror-binary "https://deb.debian.org/debian" \
	--mirror-binary-security "https://security.debian.org/debian-security" \
	--image-name "${KONARO_IMAGE}" \
	--iso-application "Konaro OS" \
	--iso-publisher "Konaro OS Project" \
	--iso-preparer "live-build; see konaro-os/docs/BUILDING.md" \
	--iso-volume "${KONARO_LABEL}" \
	--bootappend-live "boot=live components quiet splash hostname=konaro username=konaro user-fullname=Konaro locales=${KONARO_LIVE_LOCALE} keyboard-layouts=${KONARO_LIVE_KEYBOARD} timezone=${KONARO_LIVE_TIMEZONE}${KONARO_ARCH_APPEND}" \
	--bootappend-live-failsafe "boot=live components memtest noapic noapm nodma nomce nosmp nosplash nomodeset vga=788 hostname=konaro username=konaro${KONARO_ARCH_APPEND}" \
	"$@"
