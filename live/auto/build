#!/bin/sh
# Konaro OS — chamado por `lb build`. Mantém um log completo do build.
set -e

lb build noauto "$@" 2>&1 | tee build.log
# `tee` esconde o código de saída do lb; recuperamos via o arquivo de estado.
ls ./*.iso >/dev/null 2>&1 || { echo "ERRO: lb build não gerou a ISO (veja build.log)" >&2; exit 1; }
