#!/bin/sh
# Konaro OS — padrões do sistema que dependem de vários pacotes juntos.
set -e

# Navegador padrão da sessão live: Firefox. No sistema instalado, o Calamares
# (o usuário pode trocar o padrão nas Configurações do sistema).
cat > /etc/xdg/mimeapps.list <<'EOF'
[Default Applications]
text/html=firefox-esr.desktop
application/xhtml+xml=firefox-esr.desktop
x-scheme-handler/http=firefox-esr.desktop
x-scheme-handler/https=firefox-esr.desktop
application/x-ms-dos-executable=konaro-exe.desktop
application/x-msi=konaro-exe.desktop
application/vnd.microsoft.portable-executable=konaro-exe.desktop
application/vnd.debian.binary-package=konaro-install-file.desktop
application/vnd.appimage=konaro-install-file.desktop
application/x-iso9660-appimage=konaro-install-file.desktop
EOF

# Tela de login: sem sessão anterior, o SDDM começa na sessão Konaro (X11)
if [ -d /var/lib/sddm ] && [ ! -e /var/lib/sddm/state.conf ]; then
	printf '[Last]\nSession=/usr/share/xsessions/plasmax11.desktop\n' > /var/lib/sddm/state.conf
	chown sddm:sddm /var/lib/sddm/state.conf || true
fi
